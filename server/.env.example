PORT=4000
# 32-byte key, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
CORS_ORIGIN=http://localhost:5173
SQLITE_PATH=./data/connections.db

# Application database (optional). Leave empty to keep everything in the local SQLite file, one anonymous workspace, as before.
# Set it to a PostgreSQL connection string (Neon works) and the API keeps accounts, saved connections, diagrams, AI settings and the
# audit log there instead: people sign in, see only their own, and get their diagrams back on any device. The tables are created on
# start. The role needs CREATEDB and CREATEROLE if people may create databases on this server (each gets a role of its own).
# Never commit server/.env: this value holds a password.
DATABASE_URL=
# Optional pooled address of the same database (Neon's "-pooler" host), used for everyday queries. DATABASE_URL stays the direct one.
DATABASE_URL_POOLED=
# The first account is always allowed and becomes the admin. More accounts only when this is true.
ALLOW_SIGNUP=false
# How many databases one account may create on this server.
MAX_CLOUD_DATABASES_PER_USER=10
# Oracle databases: with this set, an Oracle diagram can be created as an Oracle database (a schema of its own on this Oracle server, with a
# quota and limits), and the SQL page runs Oracle SQL on it. Empty turns the feature off. The login must be allowed to create users
# (SYSTEM on Oracle Database Free). The service is the pluggable database, for example FREEPDB1. Do not commit server/.env.
#   docker run -d -p 127.0.0.1:1521:1521 -e ORACLE_PASSWORD=choose-one gvenzl/oracle-free:23-slim-faststart
ORACLE_ADMIN_URL=
# How many Oracle databases one account may create.
MAX_ORACLE_DATABASES_PER_USER=5
# Set to true when the API is served over https (marks the session cookie Secure). Set TRUST_PROXY=true behind nginx or another proxy.
COOKIE_SECURE=false
TRUST_PROXY=

# AI features (Schema Change, AI Schema, Query Modernizer) call a model through the OpenAI API and nowhere else.
# The key lives here, on the server: it is never sent to the browser, never stored by GoForge, and never goes in a Vite variable.
# Do not commit server/.env.
OPENAI_API_KEY=
# The model. Empty: gpt-5.6-luna. Can also be chosen in Schema Change -> AI settings, which lists what your key can use.
OPENAI_MODEL=
# Where requests go (the key is sent there, so it must be https). Empty: https://api.openai.com/v1. For EU data residency: https://eu.api.openai.com/v1
OPENAI_BASE_URL=
# How hard GPT-5 and o-series models think before answering: none, low, medium, high, xhigh or max. Empty: low, because thinking counts
# against the output limit and these answers are short and structured.
OPENAI_REASONING_EFFORT=
# How many times the OpenAI library tries a request again after a rate limit, a server error or a dropped connection (0 to 5). Empty: 2.
OPENAI_MAX_RETRIES=
