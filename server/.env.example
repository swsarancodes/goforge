PORT=4000
# 32-byte key, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
CORS_ORIGIN=http://localhost:7000
SQLITE_PATH=./data/connections.db

# AI schema assistant (server-side only; never expose this key through Vite variables)
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_API_KEY=
ZEN_MODEL=muse-spark-1.2-contributor-free
ZEN_TIMEOUT_MS=60000
